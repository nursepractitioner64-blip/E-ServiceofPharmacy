# Copy to .env and fill with your own deployment credentials.
PORT=2003
GOOGLE_SHEET_ID=YOUR_GOOGLE_SPREADSHEET_ID
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
AUTH_BOOTSTRAP_ADMIN_FULL_NAME=System Administrator

# LINE Login / LIFF (use the LINE Login Channel ID that owns this LIFF app)
LINE_CHANNEL_ID=YOUR_LINE_LOGIN_CHANNEL_ID
LINE_CHANNEL_SECRET=YOUR_LINE_LOGIN_CHANNEL_SECRET
PUBLIC_BASE_URL=https://your-public-https-domain.example
LINE_LIFF_ID=YOUR_LIFF_APP_ID
